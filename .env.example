# ── Supabase (인증 + 메타데이터 DB) ──
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# 서버 전용. 초대 생성 등 관리 작업에만 사용. 절대 클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Cloudflare R2 (미디어 원본 저장, S3 호환) ──
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="pics-media"
# 예: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com"

# 앱 기본 URL (매직링크/OAuth redirect 등)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 가족 공용 PIN (선택) ──
# 둘 다 설정해야 PIN 입장(/enter)이 활성화됩니다. 미설정 시 PIN 로그인 비활성.
# 보안 주의: PIN+URL을 아는 누구나 전체 열람(읽기 전용) 가능. 강한 PIN 사용 권장.
FAMILY_PIN=""
# 쿠키 서명용 비밀키. 임의의 긴 랜덤 문자열(예: openssl rand -hex 32).
PIN_COOKIE_SECRET=""

# ── 카카오/구글 로그인은 Supabase 대시보드에서 Provider 설정 ──
# Authentication → Providers → Kakao/Google 활성화 + Redirect URL 등록

